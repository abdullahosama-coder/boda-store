# انسخ الملف باسم .env وغيّر القيم
BODA_ADMIN_USER=admin
BODA_ADMIN_PASSWORD=ChangeMe-Strong-Password
BODA_SECRET_KEY=put-a-long-random-string-here
# SQLite افتراضيًا. للإنتاج استخدم PostgreSQL مثل: postgresql+psycopg://user:pass@host/dbname
BODA_DATABASE_URL=sqlite:///./boda.db
# الدومينات المسموح لها تكلم الـ API (مفصولة بفاصلة)
BODA_CORS_ORIGINS=https://abdullahosama-coder.github.io,http://127.0.0.1:5500,http://localhost:5500
